{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "check": "pnpm lint && pnpm format:check && pnpm test:run && pnpm build",
    "format": "oxfmt -c .oxfmtrc.json .",
    "format:check": "oxfmt -c .oxfmtrc.json --check .",
    "lint": "oxlint -c .oxlintrc.json --deny-warnings src vite.config.ts tailwind.config.ts postcss.config.js",
    "lint:fix": "oxlint -c .oxlintrc.json --fix --deny-warnings src vite.config.ts tailwind.config.ts postcss.config.js",
    "precommit": "lint-staged",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run --coverage"
  },
  "dependencies": {
    "@fontsource/noto-sans-sc": "^5.3.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.12",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^26.6.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.2",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.6.1",
    "husky": "9.1.7",
    "jsdom": "^30.1.1",
    "lint-staged": "17.6.0",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "postcss": "^8.5.28",
    "tailwindcss": "4.3.3",
    "typescript": "~7.0.2",
    "vite": "8.3.1",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.3.11"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,vue}": [
      "pnpm exec oxlint -c .oxlintrc.json --fix --deny-warnings",
      "pnpm exec oxfmt -c .oxfmtrc.json"
    ],
    "*.{json,jsonc,json5,css,scss,less,html,md,mdx,yaml,yml,toml}": [
      "pnpm exec oxfmt -c .oxfmtrc.json --no-error-on-unmatched-pattern"
    ]
  },
  "packageManager": "pnpm@10.28.0"
}
