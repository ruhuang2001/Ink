APP_NAME=ink-auth
PORT=8080
# Optional metrics: empty disables the registry, metrics, and DB backlog sampler.
# Leave empty for ordinary self-hosting; set 127.0.0.1:9090 for local scraping.
# For containers, bind only on a private monitoring network; do not publish it.
METRICS_ADDR=
# Optional OTLP/HTTP tracing, independent of metrics. Leave both endpoints empty
# for ordinary self-hosting. Collector tail-samples full SDK traces when enabled.
# Local opt-in tracing profile listens on http://127.0.0.1:14318.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Optional traces-only override, including /v1/traces, instead of the base endpoint.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ink?sslmode=disable
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
LOGIN_RATE_LIMIT_WINDOW=5m
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_MAX_ENTRIES=20000
TRUSTED_PROXY_CIDRS=
TRUSTED_PROXY_HEADER=
AI_CONFIG_ENCRYPTION_KEY=replace-with-a-32-byte-base64-or-raw-secret
AI_PROVIDER_TIMEOUT=45s
AI_ALLOW_INSECURE_PRIVATE_URL=false
MEMOBIRD_ACCESS_KEY=
MEMOBIRD_BASE_URL=
MEMOBIRD_TIMEOUT=30s
# Disable background print-status synchronization during isolated recovery checks.
# Manual API actions remain enabled. Legacy plugins and schedules are not executed.
WORKERS_ENABLED=true
PRINT_STATUS_SYNC_ENABLED=true
PRINT_STATUS_POLL_INTERVAL=2s
PRINT_STATUS_BATCH_SIZE=20
PRINT_STATUS_TIMEOUT=5s
PRINT_STATUS_RECHECK_INTERVAL=10s
PRINT_STATUS_MAX_RECHECK_INTERVAL=5m
PRINT_STATUS_MAX_ATTEMPTS=6
